# TMDB "API Read Access Token" from https://www.themoviedb.org/settings/api
TMDB_TOKEN=

# Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# SQLite file (default data/lateshow.db)
DATABASE_PATH=data/lateshow.db

# Production only: sign-in emails through Resend (https://resend.com). Dev prints codes in the terminal.
RESEND_API_KEY=
MAIL_FROM=Lateshow <login@example.com>
MAIL_REPLY_TO=you@example.com
