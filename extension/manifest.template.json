{
  "manifest_version": 3,
  "name": "Lateshow",
  "version": "0.1.0",
  "description": "Brings your watch history from streaming sites into Lateshow.",
  "icons": { "128": "icon-128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "128": "icon-128.png" } },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.primevideo.com/*", "__LATESHOW__/*"],
  "content_scripts": [
    { "matches": ["https://www.primevideo.com/*"], "js": ["prime.js"] },
    { "matches": ["__LATESHOW__/*"], "js": ["lateshow.js"] }
  ],
  "browser_specific_settings": { "gecko": { "id": "extension@lateshow.pyvno.xyz", "strict_min_version": "121.0" } }
}
